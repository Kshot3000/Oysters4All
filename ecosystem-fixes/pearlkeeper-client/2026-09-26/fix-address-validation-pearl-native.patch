+/**
+ * Witness versions Pearl consensus accepts as addresses, and the required
+ * witness program length. Mirrors upstream `node/btcutil/address.go`
+ * `DecodeAddress` / `newAddress`: only SegWit v1 (P2TR Taproot) and v2 (P2MR),
+ * bech32m (BIP-350), 32-byte program. Version 0 (bech32), base58, future
+ * witness versions, and non-32-byte programs are all rejected by the node.
+ */
+const PEARL_WITNESS_VERSIONS = new Set([1, 2]);
+const PEARL_WITNESS_PROGRAM_BYTES = 32;
+
+/**
+ * Pearl-native address check: bech32m with the network's HRP, witness
+ * version 1 or 2, and a 32-byte witness program — exactly what `pearld`
+ * accepts in `DecodeAddress`.
+ */
+function isPearlNativeAddress(value: string, network: Network): boolean {
+  let decoded: { prefix: string; words: number[] };
+  try {
+    decoded = bech32m.decode(value);
+  } catch {
+    return false;
+  }
+  if (decoded.prefix.toLowerCase() !== network.bech32.toLowerCase()) {
+    return false;
+  }
+  const words = decoded.words;
+  if (words.length === 0 || !PEARL_WITNESS_VERSIONS.has(words[0])) {
+    return false;
+  }
+  return bech32m.fromWords(words.slice(1)).length === PEARL_WITNESS_PROGRAM_BYTES;
+}
