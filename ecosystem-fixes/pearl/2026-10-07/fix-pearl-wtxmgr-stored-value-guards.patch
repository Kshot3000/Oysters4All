From ceb4bdcea12f26f8d97c243f2b0d2a0faac05a6a Mon Sep 17 00:00:00 2001
From: Kshot3000 <kshot9000@gmail.com>
Date: Thu, 8 Oct 2026 02:19:58 +0000
Subject: [PATCH] fix(wtxmgr): length-check credit values in unspendRawCredit
 and label values in DeserializeLabel
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

unspendRawCredit read the amount from a stored credit value with only a
nil check — a 1-8 byte value panicked on the rollback path (and the
record was rewritten before the panic). Values under the serialized
amount+flags size (9, matching fetchRawCreditAmount) now return ErrData.

DeserializeLabel read its 2-byte length prefix unchecked (panic on
shorter values) and ignored declared-vs-actual length mismatches,
returning partial labels as valid. Both now return ErrData.

Adds db_value_guards_test.go: RED panics at db.go:656 / tx.go:1253 ->
GREEN, missing-credit and well-formed round-trips pinned, plus a
contract pin for existsRawUnspent's existing 36-byte guard. Full
wtxmgr suite passes; new tests race-clean.
---
 wallet/wtxmgr/db.go                   |   5 +
 wallet/wtxmgr/db_value_guards_test.go | 182 ++++++++++++++++++++++++++
 wallet/wtxmgr/tx.go                   |  11 ++
 3 files changed, 198 insertions(+)
 create mode 100644 wallet/wtxmgr/db_value_guards_test.go

diff --git a/wallet/wtxmgr/db.go b/wallet/wtxmgr/db.go
index 90d02208..8b246d37 100644
--- a/wallet/wtxmgr/db.go
+++ b/wallet/wtxmgr/db.go
@@ -644,6 +644,11 @@ func unspendRawCredit(ns walletdb.ReadWriteBucket, k []byte) (btcutil.Amount, er
 	if v == nil {
 		return 0, nil
 	}
+	if len(v) < 9 {
+		str := fmt.Sprintf("%s: short read (expected %d bytes, "+
+			"read %d)", bucketCredits, 9, len(v))
+		return 0, storeError(ErrData, str, nil)
+	}
 	newv := make([]byte, 9)
 	copy(newv, v)
 	newv[8] &^= 1 << 0
diff --git a/wallet/wtxmgr/db_value_guards_test.go b/wallet/wtxmgr/db_value_guards_test.go
new file mode 100644
index 00000000..252d5dfa
--- /dev/null
+++ b/wallet/wtxmgr/db_value_guards_test.go
@@ -0,0 +1,182 @@
