--- a/Dockerfile
+++ b/Dockerfile
@@ -7,12 +7,22 @@
 # Build (from this repo root):
 #   docker buildx build -t pearl-miner .
 
+# Pinned Pearl release. The node binary AND the miner source must track the
+# same upstream release: consensus rules changed at the salted-seed hard fork
+# (mainnet height 99000, Aug 2026 — V2 MoE -> V3 salted noise-seed ZK
+# certificates), and a pre-fork pearld (< v1.4.1) cannot validate post-fork
+# blocks, so the image would stall below height 99000 and never mine current
+# mainnet. Bump this on new upstream releases (node binary + miner source move
+# together automatically).
+ARG PEARL_RELEASE=v1.4.8
+
 ARG CUDA_VERSION=12.9.1
 
 # ============================================================
 # Stage 1: Builder — compile CUDA kernels + Python packages
 # ============================================================
 FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04 AS builder
+ARG PEARL_RELEASE
 
 # Install system deps
 RUN apt-get update && apt-get install -y --no-install-recommends \
@@ -43,8 +53,9 @@ RUN uv python install 3.12 --default
 
 WORKDIR /app
 
-# Clone Pearl monorepo
-RUN git clone --depth 1 https://github.com/pearl-research-labs/pearl.git .
+# Clone Pearl monorepo, pinned to the release above so miner source and
+# node binary always agree on consensus rules.
+RUN git clone --depth 1 --branch ${PEARL_RELEASE} https://github.com/pearl-research-labs/pearl.git .
 
 # Install dependencies (remote packages first for caching)
 RUN --mount=type=cache,target=/root/.cache/uv \
@@ -68,12 +79,16 @@ RUN --mount=type=cache,target=/root/.cache/uv \
 # Stage 2: Download Go binaries (pearld, oyster, prlctl)
 # ============================================================
 FROM ubuntu:24.04 AS go-bins
+ARG PEARL_RELEASE
 
 RUN apt-get update && apt-get install -y curl tar && rm -rf /var/lib/apt/lists/*
 
-RUN curl -LO https://github.com/pearl-research-labs/pearl/releases/download/pearl-wallet-v1.0.0/go-binaries-linux-amd64-v1.0.2.tar.gz \
+# Post-fork node binary. The v1.0.2 binaries previously pinned here predate the
+# salted-seed hard fork (mainnet height 99000) and cannot validate V3
+# certificates — the image could not sync or mine current mainnet.
+RUN curl -LO https://github.com/pearl-research-labs/pearl/releases/download/${PEARL_RELEASE}/pearl-linux-amd64-${PEARL_RELEASE}.tar.gz \
     && mkdir -p /go-bins \
-    && tar xzf go-binaries-linux-amd64-v1.0.2.tar.gz -C /go-bins \
+    && tar xzf pearl-linux-amd64-${PEARL_RELEASE}.tar.gz -C /go-bins \
     && chmod +x /go-bins/*
 
 # ============================================================
