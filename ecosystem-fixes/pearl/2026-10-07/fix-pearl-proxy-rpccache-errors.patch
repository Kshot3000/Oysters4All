From b151ad50709e9254f2c95c3eaa9f3cbb8c41220b Mon Sep 17 00:00:00 2001
From: Kshot3000 <kshot9000@gmail.com>
Date: Wed, 7 Oct 2026 12:29:10 +0000
Subject: [PATCH] fix(proxy): do not cache JSON-RPC error responses in
 caddy-jsonrpc-cache
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

pearld reports RPC failures as HTTP 200 with an error field set (e.g.
-28 'Loading block index...' while the node warms up). fetchFromUpstream
cached any HTTP 200 response, so one transient error was replayed to
every caller for the whole TTL — with the shipped getblocktemplate
rule, miners kept receiving a stale warmup error after the node had
recovered.

Only store responses that do not carry a JSON-RPC error. The caller
that triggered the fetch still receives the live error; it is just
never written to the cache.

Adds TestErrorResponsesNotCached: a backend that fails once with an
RPC error then succeeds — the error is not replayed, the next request
reaches the recovered backend, and the successful response is cached
as before. Full module suite passes, including -race.
---
 proxy/caddy-jsonrpc-cache/handler.go      | 16 +++++-
 proxy/caddy-jsonrpc-cache/handler_test.go | 60 +++++++++++++++++++++++
 2 files changed, 75 insertions(+), 1 deletion(-)

diff --git a/proxy/caddy-jsonrpc-cache/handler.go b/proxy/caddy-jsonrpc-cache/handler.go
index bc825e0a..b9335cf0 100644
--- a/proxy/caddy-jsonrpc-cache/handler.go
+++ b/proxy/caddy-jsonrpc-cache/handler.go
@@ -136,7 +136,7 @@ func (h Handler) fetchFromUpstream(r *http.Request, body []byte, next caddyhttp.
 		ttl:      ttl,
 	}
 
-	if rec.statusCode == http.StatusOK {
+	if rec.statusCode == http.StatusOK && !isJSONRPCError(entry.body) {
 		h.cache.set(method, entry)
 
 		h.logger.Debug("cached JSON-RPC response",
@@ -149,6 +149,20 @@ func (h Handler) fetchFromUpstream(r *http.Request, body []byte, next caddyhttp.
 	return entry, nil
 }
 
+// isJSONRPCError reports whether body is a JSON-RPC response carrying an
+// error. pearld reports RPC failures (node warming up, bad params, ...) as
+// HTTP 200 with an error field set, so the status code alone cannot keep
+// failures out of the cache: a cached error would be replayed to every
+// caller for the whole TTL, long after the node recovered. Bodies that do
+// not parse as a JSON-RPC response are not treated as errors.
+func isJSONRPCError(body []byte) bool {
+	var resp jsonrpcResponse
+	if err := json.Unmarshal(body, &resp); err != nil {
+		return false
+	}
+	return len(resp.Error) > 0 && string(resp.Error) != "null"
+}
+
 // cache holds the per-method cached responses behind a mutex.
 type cache struct {
 	mu      sync.RWMutex
diff --git a/proxy/caddy-jsonrpc-cache/handler_test.go b/proxy/caddy-jsonrpc-cache/handler_test.go
index e291aa8b..6a6c36fa 100644
--- a/proxy/caddy-jsonrpc-cache/handler_test.go
+++ b/proxy/caddy-jsonrpc-cache/handler_test.go
@@ -188,6 +188,66 @@ func TestMalformedRequestsPassthrough(t *testing.T) {
 	}
 }
 
+// flakyBackend returns a JSON-RPC error (HTTP 200, error field set — how
+// pearld reports RPC failures) for the first failCalls requests, then a
+// successful result.
+type flakyBackend struct {
+	calls     atomic.Int64
+	failCalls int64
+}
+
+func (b *flakyBackend) ServeHTTP(w http.ResponseWriter, r *http.Request) error {
+	n := b.calls.Add(1)
+	body, _ := io.ReadAll(r.Body)
+	var req jsonrpcRequest
+	json.Unmarshal(body, &req)
+
+	var resp jsonrpcResponse
+	if n <= b.failCalls {
+		resp = jsonrpcResponse{
+			JSONRPC: "2.0",
+			ID:      req.ID,
+			Error:   json.RawMessage(`{"code":-28,"message":"Loading block index..."}`),
+		}
+	} else {
+		resp = jsonrpcResponse{
+			JSONRPC: "2.0",
+			ID:      req.ID,
+			Result:  json.RawMessage(`{"capabilities":{}}`),
+		}
+	}
+	out, _ := json.Marshal(resp)
+	w.Header().Set("Content-Type", "application/json")
+	w.Write(out)
+	return nil
+}
+
+func TestErrorResponsesNotCached(t *testing.T) {
+	backend := &flakyBackend{failCalls: 1}
+	h := newTestHandler(CacheRule{Method: "getblocktemplate", TTL: caddy.Duration(5 * time.Second)})
+
+	w1 := doRequest(t, h, backend, "getblocktemplate", 1)
+	assert.Equal(t, int64(1), backend.calls.Load())
+	var resp1 jsonrpcResponse
+	require.NoError(t, json.Unmarshal(w1.Body.Bytes(), &resp1))
+	require.NotEmpty(t, resp1.Error, "first response should be the upstream error")
+
+	// The error must not be replayed from cache: the next request goes back
+	// to the (now recovered) backend and gets the real result.
+	w2 := doRequest(t, h, backend, "getblocktemplate", 2)
+	assert.Equal(t, int64(2), backend.calls.Load(), "error response must not be served from cache")
+	assert.Empty(t, w2.Header().Get("X-Jsonrpc-Cache"))
+	var resp2 jsonrpcResponse
+	require.NoError(t, json.Unmarshal(w2.Body.Bytes(), &resp2))
+	assert.Empty(t, resp2.Error, "second response should be the recovered result")
+	assert.NotEmpty(t, resp2.Result)
+
+	// The successful response IS cached.
+	w3 := doRequest(t, h, backend, "getblocktemplate", 3)
+	assert.Equal(t, int64(2), backend.calls.Load(), "successful response should be cached")
+	assert.Equal(t, "HIT", w3.Header().Get("X-Jsonrpc-Cache"))
+}
+
 func TestGETRequestsPassthrough(t *testing.T) {
 	var backendCalls atomic.Int64
 	backend := caddyhttp.HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
-- 
