# Copy to .env and fill in your Oyster wallet RPC credentials.
# The faucet backend refuses drips (HTTP 503) until OYSTER_RPC_USER is set.

# Faucet HTTP listen address
PORT=8090
HOST=127.0.0.1

# Which Pearl test network this faucet serves: testnet | testnet2
# (both use the tprl bech32 HRP)
FAUCET_NETWORK=testnet

# Economics
MAX_DRIP_PRL=1
DRIP_COOLDOWN_HOURS=24
DAILY_CAP_PRL=100

# Oyster wallet daemon legacy JSON-RPC (wallet/config.go defaults:
# 127.0.0.1:44209 on testnet, 44211 on testnet2, 44207 on mainnet)
OYSTER_RPC_URL=http://127.0.0.1:44209
OYSTER_RPC_USER=
OYSTER_RPC_PASS=

# CORS: which origin may call the API (the GitHub Pages faucet, or * for dev)
CORS_ORIGIN=*

# JSON file recording past drips (rate limiting). Created automatically.
STORE_FILE=./drips.json
