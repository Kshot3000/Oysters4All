+  const stats = stats24h(trades, 1.2);
+  assert.equal(stats.high, 1.5);
+  assert.equal(stats.low, 1.0);
+  assert.equal(stats.volume, 6);
+  assert.equal(stats.turnover, 2 * 1.0 + 4 * 1.5);
+  assert.equal(stats.changePercent, (1.5 / 1.2 - 1) * 100);
+});
