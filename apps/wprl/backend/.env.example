// wPRL bridge operator — environment configuration.
//
// NOTHING secret is committed here. Copy to .env and fill in values.
// .env is loaded by operator.js / reserves-api.js via loadEnv() (no external deps).

// --- Base (EVM) chain ---
// WPRL_BASE_RPC_URL=                    # Base Sepolia RPC endpoint (https). REQUIRED.
WPRL_BRIDGE_ADDRESS=                    # Deployed WPRLBridge contract address (Base Sepolia). REQUIRED.
WPRL_TOKEN_ADDRESS=                     # Deployed WPRL token address (Base Sepolia). REQUIRED.
WPRL_BASE_CHAIN_ID=11155111             # Base Sepolia. 8453 = Base mainnet (DO NOT use without Kyle's written go-ahead).
WPRL_DEPLOY_BLOCK=                      # Block the bridge was deployed at (event scan start). REQUIRED.
WPRL_OPERATOR_KEY=                      # Operator EVM private key (0x…). REQUIRED. Env/secret-manager ONLY — never commit.

 // --- Pearl chain (pearld, chain RPC) ---
WPRL_PEARLD_RPC_URL=http://127.0.0.1:44107     # pearld JSON-RPC (port 44107).
WPRL_PEARLD_RPC_USER=rpcuser
WPRL_PEARLD_RPC_PASS=
// IMPORTANT: pearld must run with --addrindex (and --txindex) or the deposit
// watcher (searchrawtransactions) will fail. The operator refuses to start
// otherwise — see config.js.

// --- Pearl wallet (Oyster daemon, wallet RPC) ---
WPRL_OYSTER_RPC_URL=http://127.0.0.1:44207    # Oyster wallet JSON-RPC listen port.
WPRL_OYSTER_RPC_USER=rpcuser
WPRL_OYSTER_RPC_PASS=
WPRL_VAULT_ADDRESS=                            # Operator's Pearl vault address (prl1…). REQUIRED.

// --- Bridge economics (must match the deployed contracts) ---
WPRL_MIN_CONFIRMATIONS=6               # Pearl confirmations before a deposit is honored.
WPRL_FEE_BPS=25                        # 0.25% each way. Checked against the bridge contract at startup.
WPRL_PRL_FEE_ADDRESS=prl1p62v09vuzyd8kdz9l23jaf3kph4wwx6jqcmhkkhg8lhr2qlxky8psu3zw9d
WPRL_EVM_FEE_ADDRESS=0x4b6f3BC697D9dAF3e8dE182aEc56eD208B9087f1

// --- Operator behavior ---
WPRL_POLL_SECONDS=60                   # Pearl deposit scan cadence.
WPRL_EVENT_POLL_SECONDS=30             # Base WithdrawRequested event poll cadence.
WPRL_STATE_FILE=./state.json          # Persisted cursor (processed txids, last event block).
WPRL_API_PORT=8080                     # Proof-of-reserves HTTP API port.
WPRL_MIN_DEPOSIT_GRAINS=100000         # Dust guard: ignore deposits below 0.001 PRL.
