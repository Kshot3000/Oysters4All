{
  "description": "Typed TypeScript JSON-RPC client for a Pearl (pearld) node",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "pearl",
    "prl",
    "pearld",
    "json-rpc",
    "blockchain"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "pearl-rpc-client",
  "scripts": {
    "build": "tsc",
    "demo": "npx tsx src/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test test/client.test.ts"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.1.0"
}
